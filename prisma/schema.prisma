generator client {
  provider = "prisma-client"

  runtime                = "workerd"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"

  output          = "../generated/prisma"
  previewFeatures = ["queryCompiler", "driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  username  String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String?
  email         String? @unique
  emailVerified Boolean @default(false)
  image         String?

  role       String?
  banned     Boolean?
  banReason  String?
  banExpires DateTime?

  // Relations
  credentials Credential[]
  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]
  apikeys     Apikey[]
  sites       Site[]

  stripeSubscription  StripeSubscription?
  squeezeSubscription SqueezeSubscription?

  @@map("user")
}

model Credential {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)

  @@index([credentialId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@index([identifier])
  @@map("verification")
}

// ── Orgs ─────────────────────────────────────────────────────────────────────

model Organization {
  id        String   @id
  name      String
  slug      String?  @unique
  logo      String?
  createdAt DateTime
  metadata  String?

  members     Member[]
  invitations Invitation[]
  teams       Team[]
  apikeys     Apikey[]
  sites    Site[]
  plugins  OrgPlugin[]
  transcriptionUsage TranscriptionUsage[]
  diarizations       SessionDiarization[]
  pods               Pod[]                // NEW (R1 pods pass)

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime
  teamId         String?

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  teamId         String?

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@map("invitation")
}

model Team {
  id             String       @id
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?

  @@index([organizationId])
  @@map("team")
}

// ── API Keys ─────────────────────────────────────────────────────────────────

model Apikey {
  id             String        @id
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String?
  service        String?
  keyType        String?
  start          String?
  prefix         String?
  key            String
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@index([organizationId])
  @@index([service, keyType])
  @@map("apikey")
}

// ── Billing ──────────────────────────────────────────────────────────────────

model StripeSubscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   String @default("free")
  status String @default("active")

  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripeCustomerId     String? @map("stripe_customer_id")
  stripePriceId        String? @map("stripe_price_id")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at")

  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tier])
  @@index([status])
  @@index([stripeSubscriptionId])
  @@index([stripeCustomerId])
  @@map("stripe_subscriptions")
}

model SqueezeSubscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier   String @default("free")
  status String @default("active")

  lemonSqueezySubscriptionId String? @unique @map("lemon_squeezy_subscription_id")
  lemonSqueezyCustomerId     String? @map("lemon_squeezy_customer_id")
  lemonSqueezyVariantId      String? @map("lemon_squeezy_variant_id")

  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  trialEndsAt        DateTime? @map("trial_ends_at")
  endsAt             DateTime? @map("ends_at")

  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tier])
  @@index([status])
  @@index([lemonSqueezySubscriptionId])
  @@map("squeeze_subscriptions")
}

model Site {
  id        String   @id @default(uuid())
  siteKey   String   @unique @map("site_key")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  domains   String   @default("") // comma-separated, SQLite has no array type
  organizationId String? @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([siteKey])
  @@map("site")
}

model QlaveSessionLog {
  id           String    @id @default(uuid())
  siteKey      String    @map("site_key")
  sessionId    String    @map("session_id")
  startedAt    DateTime  @map("started_at")
  endedAt      DateTime? @map("ended_at")
  peakPeers    Int       @default(0) @map("peak_peers")
  messageCount Int       @default(0) @map("message_count")
  durationMs   Int?      @map("duration_ms")

  peerMinutes      Int @default(0)  // sum of all peer durations in minutes
  transcriptChunks Int @default(0)  // total caption chunks received
  silencePct       Int @default(0)  // % of session with no transcription (0-100)

  createdAt    DateTime  @default(now()) @map("created_at")

  // NEW (R1 pods pass) — pod this session belongs to.
  // Nullable for backward compat: existing rows have null until they're touched
  // (self-healing). New sessions get a pod-of-1 auto-created in pipeline Phase 0
  // if no podId was specified in the diarization request.
  podId String? @map("pod_id")
  pod   Pod?    @relation(fields: [podId], references: [id])

  @@index([siteKey])
  @@index([startedAt])
  @@index([sessionId])
  @@index([podId])   // NEW (R1 pods pass)
  @@map("qlave_session_log")
}

// ── New models ────────────────────────────────────────────────────────────────

model OrgPlugin {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plugin         String       // "transcription" | "recording" | "summary" — extensible
  enabled        Boolean      @default(true)

  // mode: sample = 1min demo, trial = time+usage gated, active = paid
  mode           String       @default("sample") // "sample" | "trial" | "active"

  // tier maps to model + cap — abstracted from user
  tier           String       @default("free") // "free" | "starter" | "pro" | "scale"

  // trial gates — whichever hits first
  trialStartedAt DateTime?    @map("trial_started_at")
  trialEndsAt    DateTime?    @map("trial_ends_at")     // trialStartedAt + 14 days
  trialMinuteCap Int          @default(60)              @map("trial_minute_cap")

  // per-user kill switch — null = no per-user limit enforced (org cap only)
  maxMinutesPerUser Int?      @map("max_minutes_per_user")

  // config blob for plugin-specific settings (JSON string, SQLite has no JSON type)
  config         String?      // e.g. {"defaultLanguage":"en","allowModelSelect":false}

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")

  @@unique([organizationId, plugin])
  @@index([organizationId])
  @@map("org_plugin")
}

model TranscriptionUsage {
  id             String   @id @default(uuid())

  // identity — always both, enforce at either level
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  sessionId      String?  @map("session_id")   // null = test page / API call
  siteKey        String   @map("site_key")

  // what was used
  model          String   // full model id e.g. "@cf/openai/whisper-large-v3-turbo"
  audioSeconds   Float    @map("audio_seconds")
  neuronsUsed    Float    @map("neurons_used")
  costUsd        Float    @map("cost_usd")

  // mode at time of request — for analytics
  mode           String   // "sample" | "trial" | "active"

  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, recordedAt])  // main analytics query
  @@index([model, recordedAt])           // cost-per-model query
  @@index([sessionId])
  @@map("transcription_usage")
}

model SessionTranscript {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  siteKey   String   @map("site_key")
  chunks    String   // JSON array of {peerId, displayName, text, timestamp}
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([siteKey])
  @@map("session_transcript")
}

model SessionSummary {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  siteKey   String   @map("site_key")
  summary   String   // JSON: {tldr, keyMoments, actionItems, speakerSummary, topics}
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([sessionId])
  @@index([siteKey])
  @@map("session_summary")
}

model RecordingManifest {
  id          String   @id @default(uuid())
  sessionId   String   @unique @map("session_id")
  orgId       String   @map("org_id")
  siteKey     String   @map("site_key")
  r2Key       String   @map("r2_key")       // R2 key of session.json manifest
  peerCount   Int      @default(0) @map("peer_count")
  assembledAt DateTime? @map("assembled_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([orgId])
  @@index([sessionId])
  @@index([siteKey])
  @@map("recording_manifest")
}

model SessionDiarization {
  id             String   @id @default(uuid())
 
  // ── Identity ──────────────────────────────────────────────────────────────
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  siteKey        String       @map("site_key")
  sessionId      String       @map("session_id")
  peerId         String       @map("peer_id")
 
  // ── Provider identity ─────────────────────────────────────────────────────
  // `provider` is the full registry name resolved by getDiarizationProvider()
  // — e.g. "workers-ai-nova3", "grok", "deepgram-direct". Internal.
  // `tag` is the short display/path suffix — e.g. "nova3", "grok", "nova3+grok".
  // Defaults derived from provider (strip "workers-ai-" prefix, lowercase).
  // Multiple rows per (session, peer) allowed for A/B testing; the
  // (session, peer, tag) tuple is unique.
  provider       String
  tag            String       @default("nova3")   // NEW
  providerOpts   String?      @map("provider_opts")  // JSON string
 
  // ── Overall pipeline status ───────────────────────────────────────────────
  // Reflects the most recent runPipeline() call. Per-step status fields below
  // give more detail; this is the top-level summary for list views.
  status         String       @default("queued")  // "queued" | "running" | "done" | "failed"
  attempts       Int          @default(0)
  error          String?
  triggeredBy    String?      @map("triggered_by")  // userId | "queue:auto" | "manual:curl" | "regen:user"
 
  // ── Audio artifact (shared across providers) ──────────────────────────────
  audioKey         String?   @map("audio_key")
  audioBytes       Int?      @map("audio_bytes")
  audioStatus      String?   @map("audio_status")        // "done" | "failed" | "skipped" | null
  audioError       String?   @map("audio_error")
  audioGeneratedAt DateTime? @map("audio_generated_at")
 
  // ── Waveform artifact (shared across providers) ───────────────────────────
  waveformKey         String?   @map("waveform_key")
  waveformBytes       Int?      @map("waveform_bytes")
  waveformPps         String?   @map("waveform_pps")     // "1", "0.2", etc — pixels-per-second
  waveformStatus      String?   @map("waveform_status")
  waveformError       String?   @map("waveform_error")
  waveformGeneratedAt DateTime? @map("waveform_generated_at")
 
  // ── Diarization artifact (provider-specific, tagged in R2 path) ───────────
  diarizationKey         String?   @map("diarization_key")
  diarizationBytes       Int?      @map("diarization_bytes")
  diarizationStatus      String?   @map("diarization_status")
  diarizationError       String?   @map("diarization_error")
  diarizationGeneratedAt DateTime? @map("diarization_generated_at")
 
  // ── Timeline artifact (provider-specific, derived from diarization) ──────
  timelineKey         String?   @map("timeline_key")
  timelineBytes       Int?      @map("timeline_bytes")
  timelineStatus      String?   @map("timeline_status")
  timelineError       String?   @map("timeline_error")
  timelineGeneratedAt DateTime? @map("timeline_generated_at")

  // ── Cleanup artifact (R2 audit of what cleanup did) ──────────────────────
  // NEW (cleanup pass)
  // The user-visible result of cleanup lives in `wordOverrides` below.
  // These fields track the audit JSON saved to R2 + the step's status,
  // following the same pattern as the other artifacts above.
  cleanupKey         String?   @map("cleanup_key")
  cleanupBytes       Int?      @map("cleanup_bytes")
  cleanupStatus      String?   @map("cleanup_status")
  cleanupError       String?   @map("cleanup_error")
  cleanupGeneratedAt DateTime? @map("cleanup_generated_at")
 
  // ── Result payload (queryable copy of diarization.json) ───────────────────
  // Slim copy of diarization for fast list views + transcript search without
  // hitting R2. Raw provider response NOT included — that's in R2 only.
  result         String?     // JSON: { words, speakers, transcript, durationSec, provider }
  wordCount      Int?         @map("word_count")
  speakerCount   Int?         @map("speaker_count")
  durationSec    Float?       @map("duration_sec")
  transcript     String?     // plain text — for LIKE-based keyword search
 
  // ── Speaker labels + "me" pointer ─────────────────────────────────────────
  // JSON: { labels?: { "speaker_0": "Ryan" }, me?: "speaker_0" }
  speakerLabels  String?      @map("speaker_labels")
 
  // ── Per-word edits + locks (R1 pods pass) ─────────────────────────────────
  // JSON: { edits: [{wordIndex, original, text, at}], locks: [wordIndex...] }
  wordOverrides  String?      @map("word_overrides")
 
  // ── Timestamps ────────────────────────────────────────────────────────────
  createdAt      DateTime     @default(now())  @map("created_at")
  startedAt      DateTime?    @map("started_at")
  completedAt    DateTime?    @map("completed_at")
 
  // ── LEGACY ────────────────────────────────────────────────────────────────
  // Old single-artifact pointer. Was the only R2 key tracked before the
  // multi-artifact / tagged refactor. Existing code writes here; new code
  // writes diarizationKey. Backfill script copies r2Key → diarizationKey for
  // existing rows. Drop this field in a future migration once all reads
  // point to diarizationKey.
  r2Key                  String?      @map("r2_key")
 
  @@unique([sessionId, peerId, tag])      // CHANGED — one row per (session, peer, tag)
  @@index([organizationId])
  @@index([sessionId])
  @@index([sessionId, peerId])
  @@index([siteKey])
  @@index([organizationId, createdAt])
  @@map("session_diarization")
}

// ── Pods (R1 pods pass) ──────────────────────────────────────────────────────
// A Pod is a *context bubble* for a group of related sessions. It owns
// vocabulary (Anchors) that helps the AI hear the right words across all
// sessions inside it. Default = pod of 1 (each session gets its own pod).
// User can later combine sessions under a shared pod.
//
// Org owns pods. Sessions reference pods via QlaveSessionLog.podId.
// Anchors are pod-scoped vocabulary — created/edited via PodAnchor rows.

model Pod {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Display name (e.g. "Brave Crimson Pod"). Auto-generated from
  // unique-names-generator if not provided. User can rename anytime.
  name           String

  // URL-friendly variant of the name. Auto-derived from name on create.
  // Unique within the org so users can route /pods/{slug}.
  slug           String

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt      @map("updated_at")

  sessions       QlaveSessionLog[]
  anchors        PodAnchor[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("pod")
}

// An Anchor is a canonical word/phrase the user has taught the pod.
// At display time: tokens matching canonical (or being edited TO canonical)
// are reinforced as the correct spelling.
// At diarization time (R2 — deferred): canonical strings are passed to the
// provider as a vocabulary boost (nova-3 keyterms / Whisper prompt).
//
// v1: just canonical + audit timestamp. v2+ may add pronunciation hint,
// audio sample refs, alias variants, etc — all additive.

model PodAnchor {
  id        String   @id @default(uuid())
  podId     String   @map("pod_id")
  pod       Pod      @relation(fields: [podId], references: [id], onDelete: Cascade)

  canonical String   // e.g. "Kelly", "K'Ynian", "GraphQL"

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([podId, canonical])
  @@index([podId])
  @@map("pod_anchor")
}